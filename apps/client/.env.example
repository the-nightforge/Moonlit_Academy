# Copy to .env.local — every entry is optional.

# Backend the Vite dev server proxies `/api/*` (HTTP + WebSocket) to.
# Empty/local default: http://localhost:8787 (API_PORT selects the port).
# Point at the Render deployment to develop against the remote backend:
#API_PROXY_TARGET=https://vong-nguyet.onrender.com

# Port of the local `apps/server` when API_PROXY_TARGET is unset.
#API_PORT=8787

# API origin baked into the production build (`16` §7.6). Leave empty for
# same-origin hosting; set https://<render-domain> for split hosting (Vercel).
#VITE_API_BASE=
