{
  "name": "vong-nguyet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "playtest:build": "pnpm --filter server exec vite build --config ../../scripts/playtest/vite.config.ts",
    "playtest": "node output/playtest-tool/main.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
