# Vọng Nguyệt Thư Viện — systemd unit mẫu (`16` §7).
# Chép vào /etc/systemd/system/vong-nguyet.service, sửa ALLOWED_ORIGINS thành
# tên miền thật, rồi `systemctl enable --now vong-nguyet`.

[Unit]
Description=Vong Nguyet Thu Vien server
After=network.target

[Service]
Type=simple
User=vongnguyet
WorkingDirectory=/srv/vong-nguyet
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=HOST=127.0.0.1
Environment=DB_PATH=/srv/vong-nguyet/data/vong-nguyet.db
Environment=TRUST_PROXY=1
Environment=ALLOWED_ORIGINS=https://vong-nguyet.example.com
Environment=BACKUP_DIR=/srv/vong-nguyet/backups
ExecStart=/usr/bin/node apps/server/dist/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
